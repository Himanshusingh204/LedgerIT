NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never expose this to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Cloudflare Turnstile site key for the sign-up bot-protection widget
# (components/auth/sign-up-form.tsx). Leave unset and the widget just doesn't render — sign-up
# still works, it's simply unprotected, same as today. Get a free site key + secret at
# https://dash.cloudflare.com/?to=/:account/turnstile, then also set `auth.captcha` in
# supabase/config.toml (see the commented block there) with the secret so Supabase Auth actually
# verifies the token server-side — the widget alone does nothing without that.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
