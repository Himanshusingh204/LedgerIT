# ==============================================================================
# LedgerIT - Git Ignore Configuration
# Only essential, security-critical, and build/runtime generated files are ignored.
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*

# Build outputs & compile caches
/.next/
/out/
/build/
*.tsbuildinfo
next-env.d.ts

# Security & environment credentials (template .env.example remains tracked)
.env
.env*.local
.env.production
.env.staging

# Test results, coverage & runner caches
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Temporary test screenshots & logs
screenshot-*.png
nav-*.png
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Supabase local transient files
/supabase/.branches
/supabase/.temp

# Operating system & editor artifacts
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/

# Local agent caches & transient screenshot dumps
/.claude/*
!/.claude/skills
/.claude/skills/**/screenshots/
/.claudeskills
